<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests that don't need the game running: every Harmony patch still binds to the game the build compiles against
       (CI: the newest dedicated server, every week). The plugin and the game's assemblies load into .NET as plain libraries. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <!-- the plugin targets .NET Framework 4.6.2; its types load fine here -->
    <NoWarn>$(NoWarn);NU1702;MSB3277</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <ValheimDir Condition="'$(ValheimDir)' == ''">$(VALHEIM_DIR)</ValheimDir>
    <ManagedDir Condition="Exists('$(ValheimDir)/valheim.app/Contents/Resources/Data/Managed')">$(ValheimDir)/valheim.app/Contents/Resources/Data/Managed</ManagedDir>
    <ManagedDir Condition="'$(ManagedDir)' == '' And Exists('$(ValheimDir)/valheim_server_Data/Managed')">$(ValheimDir)/valheim_server_Data/Managed</ManagedDir>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(ValheimDir)/valheim_Data/Managed</ManagedDir>
    <BepInExDir>$(ValheimDir)/BepInEx</BepInExDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SeatedCapeFix/SeatedCapeFix.csproj" />
    <!-- copied next to the tests so they load (never shipped) -->
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)/UnityEngine.CoreModule.dll" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)/UnityEngine.dll" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ManagedDir)/UnityEngine.PhysicsModule.dll" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(ManagedDir)/UnityEngine.AnimationModule.dll" />
    <Reference Include="MagicaClothV2" HintPath="$(ManagedDir)/MagicaClothV2.dll" />
    <Reference Include="0Harmony" HintPath="$(BepInExDir)/core/0Harmony.dll" />
    <Reference Include="BepInEx" HintPath="$(BepInExDir)/core/BepInEx.dll" />
    <Reference Include="assembly_valheim" HintPath="$(ManagedDir)/assembly_valheim.dll" />
    <Reference Include="assembly_utils" HintPath="$(ManagedDir)/assembly_utils.dll" />
  </ItemGroup>

</Project>
